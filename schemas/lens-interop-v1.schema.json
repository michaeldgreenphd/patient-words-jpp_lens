{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit local linear lens manifest",
  "type": "object",
  "required": ["schema_version", "method", "method_evidence", "model", "artifact", "capture_site", "layer_indexing", "stream_reduction", "readout", "source_layers", "target_layer"],
  "properties": {
    "schema_version": {"const": "lens-interop/1"},
    "method": {"enum": ["j_lens", "jpp", "r_lens"]},
    "method_evidence": {"type": "string", "minLength": 1},
    "fit_identity_evidence": {"type": ["string", "null"]},
    "model": {
      "type": "object",
      "required": ["id", "revision", "tokenizer_id", "tokenizer_revision", "width", "num_layers"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/revision"}]},
        "tokenizer_id": {"type": ["string", "null"], "minLength": 1},
        "tokenizer_revision": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/revision"}]},
        "width": {"type": "integer", "minimum": 1},
        "num_layers": {"type": "integer", "minimum": 1}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["repository", "revision", "path", "sha256"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "revision": {"$ref": "#/$defs/revision"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "capture_site": {"const": "block_output_pre_final_norm"},
    "layer_indexing": {"const": "zero_based"},
    "stream_reduction": {"const": "none"},
    "readout": {"const": "model_final_norm_then_lm_head"},
    "source_layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "target_layer": {"type": "integer", "minimum": 0}
  },
  "$defs": {"revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
  "$comment": "validate_manifest additionally checks ordering, layer bounds, exact-model equality, required evidence for known fit identities, and a bounded independently audited single-stream model identity set. Unknown identity is inspectable but cannot authorize tensor transport."
}
